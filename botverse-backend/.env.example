# ─── LLM Provider (Choose ONE) ────────────────────────────────────────────────
# For Grok (xAI) - get key from https://console.xai.com
XAI_API_KEY=
# For Sarvam AI - get key from https://dashboard.sarvam.ai
SARVAM_API_KEY=

# ─── YouTube Data API v3 ───────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs → YouTube Data API v3
YOUTUBE_API_KEY=AIza...

# ─── Spotify Web API ──────────────────────────────────────────────────────────
# Get from: https://developer.spotify.com/dashboard → Create App
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
CORS_ORIGIN=http://localhost:5173
